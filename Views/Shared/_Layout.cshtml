<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portfolio Rindra Niaina</title>
    <!-- Meta SEO classique -->
    <meta name="description" content="Portfolio de Rindra Niaina - Développeur .NET, C#, projets et compétences." />
    <meta name="keywords" content="Portfolio, .NET Core, C#, Développeur, MVC, Rindra Niaina" />
    <meta name="author" content="Rindra Niaina" />

    <!-- Open Graph (Facebook, LinkedIn) -->
    <meta property="og:title" content="@ViewData["Title"] - Portfolio Rindra Niaina" />
    <meta property="og:description" content="Découvrez mes projets et compétences en développement .NET et C#." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rindra-dotnet-portfolio.onrender.com/" />
    <meta property="og:image" content="https://rindra-dotnet-portfolio.onrender.com/images/Rindra_Twitter.webp" />

     <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - Portfolio Rindra Niaina" />
    <meta name="twitter:description" content="Découvrez mes projets et compétences en développement .NET et C#." />
    <meta name="twitter:image" content="https://rindra-dotnet-portfolio.onrender.com/images/Rindra_Twitter.webp" />


    <link rel="canonical" href="@ViewData["Canonical"]" />
    <link rel="icon" type="image/x-icon" href="~/rindra_logo.png" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav  aria-label="Navigation principale">
        <div class="logo"><img src="/images/rindra_logo.png" loading="lazy" alt="Rindra logo"/></div>
        <button id="menu-toggle">☰ Menu</button>
        <ul id="menu">
            <li><a href="#home">Accueil</a></li>
            <li><a href="#about">À propos</a></li>
            <li><a href="#projects">Projets</a></li>
            <li><a href="#skills">Outils</a></li>
            <li><a href="#experience">Expériences</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
        <button id="theme-toggle">☀️</button>
    </nav>




    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Rindra Niaina RAZAFIMANDANONA
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
