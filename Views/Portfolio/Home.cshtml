@model PortfolioMVC.Models.PortfolioModel
@{
    ViewData["Title"] = "Home";
}

<header id="home" class="hero">
  <div class="layer layer-back"></div>
  <div class="layer layer-mid"></div>
  <div class="layer layer-front">
    <div class="hero-content">
      <div class="hero-text">
        <h1>@Model.Prenom</h1>
        <p>@Model.resume</p>
        <a href="#projects" class="btn btn-hero">Voir mes projets</a>
      </div>
      <div class="hero-image">
        <img src="images/@Model.UserImage" alt="@Model.Nom @Model.Prenom"  loading="lazy"/>
      </div>
    </div>
  </div>
</header>

<section id="about" class="fade">
  <h2>À propos de moi</h2>
  <p>@Model.APropos</p>
</section>

<!-- PROJECTS -->
<section id="projects" class="fade">
  <h2>Mes projets</h2>
  <div class="projects-grid">
    @foreach(var proj in Model.Projets)
    {
        <div class="project-card">
          <img src="/images/@proj.ImageProjet" alt="@proj.TitreProjet"  loading="lazy">
          <div class="project-info">
            <h3>@proj.TitreProjet</h3>
            <p>@proj.ResumerProjet</p>
            <button class="btn-small open-modal" data-project="@proj.IdProjet.ToString()">Voir détails</button>

          </div>
        </div>

        <div id="modal-@proj.IdProjet.ToString()" class="modal">
            <div class="modal-content">
            <span class="close">&times;</span>
            <h3>@proj.TitreProjet</h3>
            <p>@proj.DetailProjet.Replace("\\n", "<br/>")</p>
          </div>
        </div>
    }
  </div>
</section>

<section id="skills" class="fade">
  <h2>Compétences</h2>
  <div class="skills-grid">
    <!-- Développement Desktop -->
    @foreach(var competence in Model.Competences)
    {
      <div class="skill">@competence.Nom</div>  
    }
  </div>
</section>

<section id="experience" class="fade">
  <h2>Expériences</h2>
  <div class="timeline">
  @foreach(var exp in Model.Experiences)
  {
    <div class="timeline-item">
      <div class="date">@exp.DateDebut.Year - @(exp.DateFin.HasValue ? exp.DateFin.Value.ToString("yyyy") : "Présent")</div>
      <div class="content">
        <h3>@exp.TitreExperience</h3>
        <p>@exp.DetailExperience.Replace("\\n", "<br/>")</p>
      </div>
    </div>
  }
  </div>
</section>


<section id="contact" class="fade">
  <h2>Contact</h2>
  <form id="contact-form">
    <input name="Name"  autocomplete="off" type="text" placeholder="Nom" class="form-control" required />
    <input name="To"  autocomplete="off" type="email" placeholder="Email" class="form-control" required />
    <input name="Subject" autocomplete="off" type="text" placeholder="Sujet" class="form-control" required />
    <textarea name="Body" placeholder="Message" class="form-control" required></textarea>
    <button type="submit" class="btn btn-hero">Envoyer</button>
  </form>
  <div id="contact-message" class="mt-2"></div>
  <div class="socials">
    @if(Model.Contacts != null)
    {
          @foreach (var contact in Model.Contacts)
          {
            if (contact.TypeContact.ToUpper() == "LINKEDIN")
            {
              <a href="@contact.AdresseContact" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="Profil LinkedIn de Rindra Niaina">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="#0077B5" role="img" aria-hidden="true">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.268c-.966 0-1.75-.784-1.75-1.75s.784-1.75 1.75-1.75 1.75.784 1.75 1.75-.784 1.75-1.75 1.75zm13.5 11.268h-3v-5.604c0-1.337-.025-3.065-1.868-3.065-1.868 0-2.154 1.459-2.154 2.968v5.701h-3v-10h2.881v1.367h.041c.401-.757 1.379-1.555 2.841-1.555 3.036 0 3.598 1.997 3.598 4.592v5.596z"/>
                </svg>
              </a>
            }
            if (contact.TypeContact.ToUpper() == "GITHUB")
            {
              <a href="@contact.AdresseContact"  target="_blank" rel="noopener noreferrer" aria-label="Profil GitHub de Rindra Niaina">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="#0077B5">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.757-1.333-1.757-1.089-.745.084-.729.084-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.468-2.38 1.235-3.22-.123-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.3 1.23a11.52 11.52 0 0 1 3-.405c1.02.005 2.045.138 3 .405 2.29-1.552 3.295-1.23 3.295-1.23.653 1.653.242 2.873.12 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.807 5.625-5.48 5.922.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
              </a>
            }
          }
      }
  </div>
</section>
<div class="chatbot-container">
  <div class="chat-toggle" id="chat-toggle">
    <img src="images/chatbot1.png" alt="Chat" class="chat-icon" />
  </div>
  <div class="chat-body" id="chat-body">
    <div class="chat-messages" id="chat-messages">
      @if (Model.ChatResponses != null && Model.ChatResponses.Any())
      {
        foreach (var msg in Model.ChatResponses)
        {
          <div class="chat-message user">
            <span>@msg.UserMessage</span>
          </div>
          <div class="chat-message bot">
            <span>@msg.BotResponse</span>
          </div>
        }
      }
      else
      {
        <div class="chat-message bot">
          <span>Bonjour! Comment puis-je vous aider aujourd'hui?</span>
        </div>
      }
    </div>
    <div class="chat-input">
        <input autocomplete="off" type="text" placeholder="Écrire un message..." id="chat-input-field" 
          name="UserMessage"/>
        <button type="button" id="chat-send-btn">➤</button>
      
    </div>
  </div>
</div>

@section Scripts {
  <script>
    document.getElementById("chat-send-btn").addEventListener("click", sendMessage);
    document.getElementById("chat-input-field").addEventListener("keypress", function(e) {
      if (e.key === "Enter") sendMessage();
    });

  async function sendMessage() {
    const input = document.getElementById("chat-input-field");
    const message = input.value.trim();
    //alert(message);
    if (!message) return;

    // affiche le message utilisateur
    const chatBox = document.getElementById("chat-messages");
    chatBox.innerHTML += `<div class="chat-message user"><span>${message}</span></div>`;
    input.value = "";

    // appel AJAX vers le contrôleur MVC
    const response = await fetch("@Url.Action("SendMessage", "portfolio")", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ Message: message })
    });

    if (response.ok) {
      const botText = await response.text();
      chatBox.innerHTML += `<div class="chat-message bot"><span>${botText}</span></div>`;
    } else {
      chatBox.innerHTML += `<div class="chat-message bot"><span>Erreur serveur.</span></div>`;
    }

    chatBox.scrollTop = chatBox.scrollHeight;
  }

  document.getElementById("contact-form").addEventListener("submit", async function (e) {
    e.preventDefault(); // empêche le rechargement de la page

    const form = e.target;
    const messageBox = document.getElementById("contact-message");

    // Construction de l’objet à envoyer
    const emailData = {
        Name: form.querySelector("[name='Name']").value,
        To: form.querySelector("[name='To']").value,
        Subject: form.querySelector("[name='Subject']").value,
        Body: form.querySelector("[name='Body']").value
    };

    // Affiche un message d’attente
    messageBox.innerHTML = "<span>⏳ Envoi en cours...</span>";
    //alert(JSON.stringify(emailData));
    try {
        const response = await fetch("@Url.Action("EnvoyerMail", "Portfolio")", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(emailData)
        });

        if (response.ok) {
            const text = await response.text();
            messageBox.innerHTML = `<span style='color:green;'>✅ ${text}</span>`;
            form.reset();
        } else {
            messageBox.innerHTML = `<span style='color:red;'>⚠️ Erreur serveur (${response.status})</span>`;
        }
    } catch (err) {
        messageBox.innerHTML = `<span style='color:red;'>⚠️ ${err.message}</span>`;
      //alert(err.message);
    }
});



  </script>
}

